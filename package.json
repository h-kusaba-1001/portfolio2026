{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && vite build --ssr",
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "deploy": "osls deploy --stage prod",
        "deploy:info": "osls info --stage prod",
        "deploy:package": "osls package --stage prod",
        "deploy:remove": "osls remove --stage prod"
    },
    "devDependencies": {
        "@cyclonedx/cyclonedx-npm": "^6.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.1.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "osls": "^4.1.0",
        "serverless-lift": "^1.37.7",
        "tailwindcss": "^4.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/react": "^3.7.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    }
}
