APP_NAME="HK Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ログは stderr に JSON で出す（U1-OB-1 / P-6）
# ローカルでも本番と同じ形式にして、環境差を減らす
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# データベースを持たない（ADR-002）
# セッション・キュー・キャッシュのいずれも DB を使わない
DB_CONNECTION=sqlite

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Markdown のパース結果をキャッシュする（ADR-003 / Q3 = B）
# Lambda 上では書き込み先を /tmp に向ける（serverless.yml 側で設定）
CACHE_STORE=file

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
